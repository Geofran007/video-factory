# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys).
# Sin ella solo se pueden generar videos a partir de contenido JSON existente (--content).
ANTHROPIC_API_KEY=

# Opcional: sobrescribe el modelo de config/providers.json (p. ej. claude-haiku-5-5 para abaratar).
# VF_LLM_MODEL=claude-sonnet-5-5

# Opcional: desactiva la búsqueda web para verificación de fuentes (más barato, todo queda "needs_review").
# VF_WEB_SEARCH=false

# Opcional: rutas de binarios si no están en el PATH.
# FFMPEG_PATH=C:\ruta\a\ffmpeg.exe
# FFPROBE_PATH=C:\ruta\a\ffprobe.exe

# Opcional: presupuesto diario máximo en USD para llamadas a Claude.
# VF_DAILY_BUDGET_USD=2.0

# Opcional: puerto de la interfaz web.
# VF_PORT=8000
