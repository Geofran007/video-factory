      "type": "scene3d",
      "model3d": "cue_rain",
      "narration": "It starts with rain: water picks up carbon dioxide and becomes a very weak acid.",
      "on_screen_text": "Slightly acidic rain",
      "highlight_words": [
        "acidic"
      ],
      "sfx": "whoosh",
