      "id": "s2",
      "role": "development",
      "type": "scene3d",
      "model3d": "mic_waves",
      "narration": "A part called the magnetron shoots out very short radio waves: microwaves.",
      "on_screen_text": "The magnetron",
      "highlight_words": [
        "magnetron"
      ],
      "sfx": "riser",
      "transition": "cut"
    },
    {
      "id": "s3",
      "role": "development",
      "type": "scene3d",
      "model3d": "mic_water",
      "narration": "Those waves flip the water molecules in your food back and forth billions of times a second.",
      "on_screen_text": "Water spins and spins",
      "highlight_words": [
        "spins"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "mic_friction",
      "narration": "Moving that fast, they bump and rub against everything around them, and that friction is heat.",
      "on_screen_text": "Friction = heat",
      "highlight_words": [
        "heat"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "mic_uneven",
      "narration": "The waves form hot and cold spots inside the oven, which is why the plate turns.",
      "on_screen_text": "That's why the plate spins",
      "highlight_words": [
        "spins"
      ],
      "sfx": "pop",
      "transition": "cut"
    },
    {
      "id": "s6",
      "role": "development",
      "type": "scene3d",
      "model3d": "mic_door",
      "narration": "The door has a mesh with holes smaller than the waves: light gets through, but microwaves don't.",
      "on_screen_text": "The door mesh",
      "highlight_words": [
        "mesh"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "mic_metal",
      "narration": "Metal reflects them and can spark, so keep metal out.",
      "on_screen_text": "No metal!",
      "highlight_words": [
        "metal!"
      ],
      "sfx": "impact",
      "transition": "cut"
    },
    {
      "id": "s8",
      "role": "development",
      "type": "scene3d",
      "model3d": "mic_ice",
      "narration": "And ice heats far worse than liquid water: that's why defrosting goes in bursts.",
      "on_screen_text": "Defrost goes in bursts",
