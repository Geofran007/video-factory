      "role": "development",
      "type": "scene3d",
      "model3d": "col_hook",
      "narration": "La naturaleza lleva millones de años inventando superpoderes. Solo hay que saber mirar.",
      "on_screen_text": "Millones de años inventando",
      "highlight_words": [
        "inventando"
      ],
      "sfx": "none",
