      "role": "development",
      "type": "scene3d",
      "model3d": "ceb_unique",
      "narration": "Y no hay dos cebras con las mismas rayas: cada una tiene su propio diseño.",
      "on_screen_text": "Rayas únicas",
      "highlight_words": [
        "únicas"
      ],
      "sfx": "none",
      "transition": "cut"
    },
