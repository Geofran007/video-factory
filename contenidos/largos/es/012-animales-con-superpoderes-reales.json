      "type": "scene3d",
      "model3d": "col_hook",
      "narration": "Tres corazones, alas invisibles de tan rápidas, caídas perfectas y rayas antimoscas.",
      "on_screen_text": "Cuatro poderes increíbles",
      "highlight_words": [
        "increíbles"
      ],
