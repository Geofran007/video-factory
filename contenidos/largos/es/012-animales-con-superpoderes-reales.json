      "id": "s36",
      "role": "development",
      "type": "scene3d",
      "model3d": "pez_oxygen",
      "narration": "En el agua hay entre veinte y cuarenta veces menos oxígeno que en el aire. Respirar ahí es un reto enorme.",
      "on_screen_text": "Poco oxígeno en el agua",
      "highlight_words": [
        "oxígeno"
      ],
      "sfx": "none",
      "transition": "cut"
