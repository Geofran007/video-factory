      "role": "development",
      "type": "scene3d",
      "model3d": "abe_less",
      "narration": "Las abejas necesitan varios kilos de miel para fabricar un kilo de cera, así que no pueden desperdiciarla.",
      "on_screen_text": "La cera es valiosa",
      "highlight_words": [
        "valiosa"
      ],
