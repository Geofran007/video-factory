      "id": "s31",
      "role": "development",
      "type": "scene3d",
      "model3d": "pul_ink",
      "narration": "Si lo atacan, suelta una nube de tinta y escapa mientras el enemigo queda confundido.",
      "on_screen_text": "Una nube de tinta",
      "highlight_words": [
        "tinta"
      ],
      "sfx": "none",
