      "id": "s34",
      "role": "development",
      "type": "scene3d",
      "model3d": "gato_land",
      "narration": "Al final aterriza con las patas como amortiguadores. Aun así, las caídas altas sí pueden lastimarlo.",
      "on_screen_text": "Patas amortiguadoras",
      "highlight_words": [
        "amortiguadoras"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s35",
      "role": "development",
      "type": "scene3d",
      "model3d": "ceb_skin",
      "narration": "Debajo de su pelaje blanco y negro, la piel de la cebra es oscura.",
      "on_screen_text": "Piel oscura debajo",
      "highlight_words": [
        "oscura"
      ],
      "sfx": "none",
      "transition": "cut"
    },
