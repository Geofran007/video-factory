      "id": "s30",
      "role": "development",
      "type": "scene3d",
      "model3d": "pez_lamellae",
      "narration": "Las branquias tienen miles de laminillas muy finas, que ofrecen una superficie enorme para atrapar oxígeno.",
      "on_screen_text": "Laminillas finísimas",
      "highlight_words": [
        "Laminillas"
      ],
      "sfx": "none",
      "transition": "cut"
    },
