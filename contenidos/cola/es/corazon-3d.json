    },
    {
      "id": "s2",
      "role": "development",
      "type": "scene3d",
      "model3d": "cor_size",
      "narration": "Es un músculo del tamaño de un puño, dividido en cuatro cámaras: dos aurículas arriba y dos ventrículos abajo.",
      "on_screen_text": "Cuatro cámaras",
      "highlight_words": [
        "Cuatro"
      ],
      "sfx": "pop",
      "transition": "cut"
    },
    {
      "id": "s3",
      "role": "development",
      "type": "scene3d",
      "model3d": "cor_two",
      "narration": "En realidad son dos bombas: el lado derecho manda sangre a los pulmones, y el izquierdo, al resto del cuerpo.",
      "on_screen_text": "Dos bombas en una",
      "highlight_words": [
        "Dos"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "cor_lungs",
      "narration": "La sangre sin oxígeno va a los pulmones, se carga de oxígeno y vuelve al corazón.",
      "on_screen_text": "Oxígeno en los pulmones",
      "highlight_words": [
        "Oxígeno"
      ],
      "sfx": "bubbles",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "cor_body",
      "narration": "Y el ventrículo izquierdo, el más fuerte, la empuja por todo el cuerpo.",
      "on_screen_text": "El más fuerte",
      "highlight_words": [
        "fuerte"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
      "id": "s6",
      "role": "development",
      "type": "scene3d",
      "model3d": "cor_spark",
      "narration": "Cada latido empieza con una chispa eléctrica en el nódulo sinusal: tu marcapasos natural.",
      "on_screen_text": "Una chispa eléctrica",
      "highlight_words": [
        "chispa"
      ],
      "sfx": "riser",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "cor_squeeze",
      "narration": "Esa señal hace que primero se aprieten las aurículas y, un instante después, los ventrículos.",
      "on_screen_text": "Primero arriba, luego abajo",
      "highlight_words": [
        "arriba,",
