      "highlight_words": [
        "instantáneo"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "pul_squeeze",
      "narration": "No tiene huesos: la única parte dura es su pico, así que pasa por cualquier hueco más grande que él.",
      "on_screen_text": "Pasa por cualquier hueco",
      "highlight_words": [
        "hueco"
