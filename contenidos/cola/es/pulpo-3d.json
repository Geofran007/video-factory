      "role": "development",
      "type": "scene3d",
      "model3d": "pul_blue",
      "narration": "Su sangre es azul porque transporta el oxígeno con cobre, en lugar del hierro que usamos nosotros.",
      "on_screen_text": "Sangre azul de cobre",
      "highlight_words": [
        "azul"
