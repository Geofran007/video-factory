      "transition": "cut"
    },
    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "pul_swim",
      "narration": "Y cuando nada, el corazón principal se detiene. Por eso prefiere caminar sobre el fondo.",
      "on_screen_text": "Nadar lo cansa",
      "highlight_words": [
        "cansa"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "pul_brain",
      "narration": "Tiene unos quinientos millones de neuronas, y dos tercios están en sus brazos: cada brazo casi piensa por sí solo.",
      "on_screen_text": "Brazos que piensan",
      "highlight_words": [
        "piensan"
