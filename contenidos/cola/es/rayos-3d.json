    {
      "id": "s3",
      "role": "development",
      "type": "scene3d",
      "model3d": "ray_charges",
      "narration": "Esos choques separan cargas: arriba quedan las positivas, abajo las negativas, y el suelo se carga al revés.",
      "on_screen_text": "Se separan las cargas",
      "highlight_words": [
        "cargas"
      ],
      "sfx": "riser",
      "transition": "cut"
    },
    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "ray_leader",
      "narration": "Cuando la diferencia es enorme, baja un canal de aire cargado, a saltos, buscando el suelo.",
      "on_screen_text": "Baja a saltos",
      "highlight_words": [
        "saltos"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "ray_strike",
      "narration": "Desde el suelo sube otra chispa a su encuentro, y cuando se tocan, la corriente viaja de golpe: ese es el destello.",
      "on_screen_text": "¡Se tocan y destella!",
      "highlight_words": [
        "destella!"
      ],
      "sfx": "impact",
      "transition": "cut"
    },
    {
      "id": "s6",
      "role": "development",
      "type": "scene3d",
      "model3d": "ray_heat",
      "narration": "Ese canal calienta el aire a unos treinta mil grados: cinco veces más que la superficie del Sol.",
      "on_screen_text": "5 veces más que el Sol",
      "highlight_words": [
        "5"
      ],
      "sfx": "riser",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "ray_thunder",
      "narration": "El aire se expande tan rápido que estalla como una explosión, y eso es el trueno.",
      "on_screen_text": "Eso es el trueno",
      "highlight_words": [
        "trueno"
      ],
      "sfx": "impact",
      "transition": "cut"
    },
    {
      "id": "s8",
      "role": "development",
      "type": "scene3d",
      "model3d": "ray_count",
      "narration": "Como la luz llega antes que el sonido, cuenta los segundos: cada tres son más o menos un kilómetro.",
      "on_screen_text": "3 segundos ≈ 1 km",
