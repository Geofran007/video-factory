      "type": "scene3d",
      "model3d": "ray_cloud",
      "narration": "Dentro de una nube de tormenta, el viento sube y hace chocar trocitos de hielo con granizo blando, millones de veces.",
      "on_screen_text": "Hielo chocando en la nube",
      "highlight_words": [
        "chocando"
      ],
