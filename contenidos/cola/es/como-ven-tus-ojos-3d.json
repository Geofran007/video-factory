    {
      "id": "s2",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_parts",
      "narration": "La luz entra por la córnea, pasa por la pupila y el cristalino la enfoca sobre la retina, al fondo del ojo.",
      "on_screen_text": "Córnea, cristalino, retina",
      "highlight_words": [
        "retina"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
      "id": "s3",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_pupil",
      "narration": "El iris ajusta la pupila: se cierra con mucha luz y se abre en la oscuridad.",
      "on_screen_text": "La pupila se ajusta",
      "highlight_words": [
        "pupila"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_rays",
      "narration": "Los rayos se cruzan dentro del ojo, así que la imagen llega a la retina ¡al revés!",
      "on_screen_text": "¡La imagen llega al revés!",
      "highlight_words": [
        "revés!"
      ],
      "sfx": "ding",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_cells",
      "narration": "En la retina hay unos ciento veinte millones de bastones, que ven con poca luz, y unos seis millones de conos.",
      "on_screen_text": "Bastones y conos",
      "highlight_words": [
        "conos"
      ],
      "sfx": "pop",
      "transition": "cut"
    },
    {
      "id": "s6",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_colors",
      "narration": "Los conos son de tres tipos, sensibles al rojo, al verde y al azul, y con ellos el cerebro mezcla todos los colores.",
      "on_screen_text": "Tres tipos de conos",
      "highlight_words": [
        "Tres"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_flip",
      "narration": "El nervio óptico lleva la señal al cerebro, que voltea la imagen y la interpreta.",
      "on_screen_text": "El cerebro la endereza",
      "highlight_words": [
        "cerebro"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
      "id": "s8",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_blind",
      "narration": "Donde sale el nervio no hay células: es el punto ciego. Tu cerebro lo rellena y nunca lo notas.",
      "on_screen_text": "Tu punto ciego",
      "highlight_words": [
        "ciego"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s9",
      "role": "surprise",
      "type": "scene3d",
      "model3d": "ojo_saccade",
      "narration": "Y tus ojos no están quietos: saltan unas tres veces por segundo, y el cerebro borra esos saltos para que veas todo estable.",
