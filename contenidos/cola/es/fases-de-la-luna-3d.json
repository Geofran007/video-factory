    {
      "id": "s2",
      "role": "development",
      "type": "scene3d",
      "model3d": "luna_myth",
      "narration": "Mucha gente cree que es la sombra de la Tierra, pero no: esa sombra solo la tapa en los eclipses.",
      "on_screen_text": "No es la sombra de la Tierra",
      "highlight_words": [
        "sombra"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s3",
      "role": "development",
      "type": "scene3d",
      "model3d": "luna_half",
      "narration": "La Luna no tiene luz propia, y el Sol siempre ilumina la mitad que lo mira.",
      "on_screen_text": "Siempre media Luna iluminada",
      "highlight_words": [
        "mitad",
        "media"
      ],
      "sfx": "riser",
      "transition": "cut"
    },
    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "luna_orbit",
      "narration": "Mientras tanto, la Luna da una vuelta alrededor de la Tierra más o menos cada mes.",
      "on_screen_text": "Una vuelta al mes",
      "highlight_words": [
        "mes"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "luna_new",
      "narration": "Cuando pasa entre la Tierra y el Sol, nos muestra su lado oscuro: es luna nueva.",
      "on_screen_text": "Luna nueva",
      "highlight_words": [
        "nueva"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s6",
      "role": "development",
      "type": "scene3d",
      "model3d": "luna_quarter",
      "narration": "Una semana después vemos media cara iluminada: cuarto creciente.",
      "on_screen_text": "Cuarto creciente",
      "highlight_words": [
        "creciente"
      ],
      "sfx": "pop",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "luna_full",
      "narration": "Y cuando la Tierra queda en medio, vemos toda la cara iluminada: luna llena.",
      "on_screen_text": "Luna llena",
      "highlight_words": [
        "llena"
      ],
      "sfx": "ding",
      "transition": "cut"
    },
    {
      "id": "s8",
      "role": "development",
      "type": "scene3d",
      "model3d": "luna_cycle",
      "narration": "El ciclo completo dura unos veintinueve días y medio, y vuelve a empezar.",
      "on_screen_text": "Ciclo de 29,5 días",
      "highlight_words": [
        "29,5"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
