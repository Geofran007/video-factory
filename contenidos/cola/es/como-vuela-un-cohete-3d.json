    {
      "id": "s3",
      "role": "development",
      "type": "scene3d",
      "model3d": "coh_newton",
      "narration": "Un cohete hace lo mismo: lanza gases hacia abajo a enorme velocidad, y esos gases lo empujan hacia arriba.",
