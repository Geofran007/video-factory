      "role": "development",
      "type": "scene3d",
      "model3d": "sl_fade",
      "narration": "Every night would be as dark as a new moon night.",
      "on_screen_text": "Dark nights",
      "highlight_words": [
        "Dark"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "sl_tide_pull",
      "narration": "The Moon stretches the oceans, and that's why we have tides.",
      "on_screen_text": "The Moon moves the sea",
      "highlight_words": [
        "sea"
      ],
      "sfx": "bubbles",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "sl_tide_none",
      "narration": "Without it, only the Sun's tides would remain, with about half the strength.",
      "on_screen_text": "Much smaller tides",
      "highlight_words": [
        "smaller"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s6",
      "role": "development",
      "type": "scene3d",
      "model3d": "sl_coral_sync",
      "narration": "And many corals, which use moonlight to spawn all at once, would lose their clock.",
      "on_screen_text": "Corals lose their clock",
      "highlight_words": [
        "clock"
      ],
      "sfx": "pop",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "lun_tilt",
      "narration": "The Moon also helps keep Earth's tilted axis steady.",
      "on_screen_text": "It steadies the axis",
      "highlight_words": [
        "axis"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
      "id": "s8",
      "role": "development",
      "type": "scene3d",
      "model3d": "sl_wobble",
      "narration": "Without it, the axis could vary more over time, and the seasons along with it.",
      "on_screen_text": "Wilder seasons",
      "highlight_words": [
        "seasons"
      ],
      "sfx": "none",
      "transition": "cut"
