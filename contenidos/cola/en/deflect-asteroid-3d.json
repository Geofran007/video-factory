      "role": "development",
      "type": "scene3d",
      "model3d": "ast_binary",
      "narration": "NASA picked two harmless asteroids: Didymos and its little moon, Dimorphos.",
      "on_screen_text": "Didymos and Dimorphos",
      "highlight_words": [
        "Dimorphos"
      ],
      "sfx": "ding",
      "transition": "cut"
    },
    {
      "id": "s3",
      "role": "development",
      "type": "scene3d",
      "model3d": "coh_hook",
      "narration": "In 2021 it launched the DART spacecraft, about the size of a small car.",
      "on_screen_text": "DART launches",
      "highlight_words": [
        "DART"
      ],
      "sfx": "riser",
      "transition": "cut"
    },
    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "ast_dart",
      "narration": "In 2022 it crashed into Dimorphos at about six kilometers per second.",
      "on_screen_text": "Impact!",
      "highlight_words": [
        "Impact!"
      ],
      "sfx": "impact",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "ast_dart",
      "narration": "No explosives: the hit itself was the push, like a billiard ball.",
      "on_screen_text": "Like billiards",
      "highlight_words": [
        "billiards"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s6",
      "role": "surprise",
      "type": "scene3d",
      "model3d": "ast_shrink",
      "narration": "It worked: Dimorphos's orbit got about thirty-three minutes shorter.",
      "on_screen_text": "33 minutes shorter",
      "highlight_words": [
        "33"
      ],
      "sfx": "ding",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "ast_deflect",
      "narration": "The trick is time: a small nudge, years ahead, is enough to make a rock miss us.",
      "on_screen_text": "The secret is time",
