      "type": "scene3d",
      "model3d": "ojo_pupil",
      "narration": "The iris adjusts the pupil: it shrinks in bright light and opens wide in the dark.",
      "on_screen_text": "The pupil adjusts",
      "highlight_words": [
        "pupil"
      ],
      "sfx": "none",
      "transition": "cut"
