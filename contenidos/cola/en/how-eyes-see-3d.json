      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_blind",
      "narration": "Where the nerve leaves there are no cells: that's the blind spot. Your brain fills it in and you never notice.",
      "on_screen_text": "Your blind spot",
      "highlight_words": [
        "blind"
      ],
      "sfx": "none",
      "transition": "cut"
    },
