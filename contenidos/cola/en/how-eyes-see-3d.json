    {
      "id": "s4",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_rays",
      "narration": "The light rays cross inside the eye, so the image lands on the retina upside down!",
      "on_screen_text": "The image is upside down!",
      "highlight_words": [
        "upside"
      ],
      "sfx": "ding",
      "transition": "cut"
    },
    {
      "id": "s5",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_cells",
      "narration": "The retina has about a hundred and twenty million rods, which see in dim light, and about six million cones.",
      "on_screen_text": "Rods and cones",
      "highlight_words": [
        "cones"
      ],
      "sfx": "pop",
      "transition": "cut"
    },
    {
      "id": "s6",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_colors",
      "narration": "Cones come in three types, sensitive to red, green and blue, and from them the brain mixes every color.",
      "on_screen_text": "Three kinds of cones",
      "highlight_words": [
        "Three"
      ],
      "sfx": "none",
      "transition": "cut"
    },
    {
      "id": "s7",
      "role": "development",
      "type": "scene3d",
      "model3d": "ojo_flip",
      "narration": "The optic nerve carries the signal to the brain, which flips the image and makes sense of it.",
      "on_screen_text": "The brain flips it",
      "highlight_words": [
        "brain"
      ],
      "sfx": "whoosh",
      "transition": "cut"
    },
    {
